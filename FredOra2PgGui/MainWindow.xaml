<Window x:Class="FredOra2PgGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fred ora2pg GUI"
        Height="720"
        Width="1080"
        MinHeight="560"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="16">
        <TabControl>
            <TabItem Header="Connexions">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,14"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Text="Configurez les connexions source et cible. Les paramètres sont conservés localement et les mots de passe sont chiffrés avec DPAPI pour votre compte Windows." />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="Database source Oracle" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Hôte" />
                                <TextBox x:Name="OracleHostTextBox" Grid.Row="0" Grid.Column="1" Margin="0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Port" />
                                <TextBox x:Name="OraclePortTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="1521" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Service Oracle" />
                                <TextBox x:Name="OracleServiceTextBox" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Propriétaire (owner)" />
                                <TextBox x:Name="OracleOwnerTextBox" Grid.Row="3" Grid.Column="1" Margin="0,4" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Utilisateur" />
                                <TextBox x:Name="OracleUsernameTextBox" Grid.Row="4" Grid.Column="1" Margin="0,4" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Mot de passe" />
                                <PasswordBox x:Name="OraclePasswordBox" Grid.Row="5" Grid.Column="1" Margin="0,4" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="Base cible PostgreSQL" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Hôte" />
                                <TextBox x:Name="PostgresHostTextBox" Grid.Row="0" Grid.Column="1" Margin="0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Port" />
                                <TextBox x:Name="PostgresPortTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="5432" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Base de données" />
                                <TextBox x:Name="PostgresDatabaseTextBox" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Schéma" />
                                <TextBox x:Name="PostgresSchemaTextBox" Grid.Row="3" Grid.Column="1" Margin="0,4" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Utilisateur" />
                                <TextBox x:Name="PostgresUsernameTextBox" Grid.Row="4" Grid.Column="1" Margin="0,4" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="Mot de passe" />
                                <PasswordBox x:Name="PostgresPasswordBox" Grid.Row="5" Grid.Column="1" Margin="0,4" />
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ConnectionStatusTextBlock"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="DimGray" />
                        <Button x:Name="TestOracleButton" Grid.Column="1" Margin="8,0,0,0" Padding="14,7" Background="#0078D4" Foreground="White" Content="Tester Oracle" Click="TestOracleButton_Click" />
                        <Button x:Name="TestPostgresButton" Grid.Column="2" Margin="8,0,0,0" Padding="14,7" Background="#0078D4" Foreground="White" Content="Tester PostgreSQL" Click="TestPostgresButton_Click" />
                        <Button x:Name="SaveSettingsButton" Grid.Column="3" Margin="8,0,0,0" Padding="14,7" Background="#0078D4" Foreground="White" Content="Enregistrer" Click="SaveSettingsButton_Click" />
                        <Button x:Name="LoadObjectsButton" Grid.Column="4" Margin="8,0,0,0" Padding="14,7" Background="#0078D4" Foreground="White" Content="Charger les objets" Click="LoadObjectsButton_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Tables">
                <DataGrid x:Name="TablesDataGrid" Margin="14" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tables source Oracle" Binding="{Binding SourceName}" Width="*" />
                        <DataGridTextColumn Header="Tables cible PostgreSQL" Binding="{Binding TargetName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Vues">
                <DataGrid x:Name="ViewsDataGrid" Margin="14" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vues source Oracle" Binding="{Binding SourceName}" Width="*" />
                        <DataGridTextColumn Header="Vues cible PostgreSQL" Binding="{Binding TargetName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Déclencheurs">
                <DataGrid x:Name="TriggersDataGrid" Margin="14" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Déclencheurs source Oracle" Binding="{Binding SourceName}" Width="*" />
                        <DataGridTextColumn Header="Déclencheurs cible PostgreSQL" Binding="{Binding TargetName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Procédures stockées">
                <DataGrid x:Name="ProceduresDataGrid" Margin="14" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Procédures source Oracle" Binding="{Binding SourceName}" Width="*" />
                        <DataGridTextColumn Header="Procédures cible PostgreSQL" Binding="{Binding TargetName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Séquences">
                <DataGrid x:Name="SequencesDataGrid" Margin="14" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Séquences source Oracle" Binding="{Binding SourceName}" Width="*" />
                        <DataGridTextColumn Header="Séquences cible PostgreSQL" Binding="{Binding TargetName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Scripts manuels PERL" Height="20" VerticalAlignment="Top">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Text="Générez des scripts SQL avec ora2pg. Sélectionnez l’exécutable, son fichier de configuration et le dossier de sortie." />

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center" Text="Exécutable ora2pg" />
                        <TextBox x:Name="Ora2PgExecutableTextBox" Grid.Row="0" Grid.Column="1" Margin="0,3" Text="ora2pg" />
                        <Button Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Margin="8,3,0,3" Padding="10,4" Content="Parcourir..." Click="BrowseOra2PgExecutableButton_Click" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center" Text="Configuration ora2pg" />
                        <TextBox x:Name="Ora2PgConfigFileTextBox" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                        <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="8,3,0,3" Padding="10,4" Content="Parcourir..." Click="BrowseOra2PgConfigButton_Click" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center" Text="Dossier de sortie" />
                        <TextBox x:Name="ScriptsOutputDirectoryTextBox" Grid.Row="2" Grid.Column="1" Margin="0,3" />
                        <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="8,3,0,3" Padding="10,4" Content="Parcourir..." Click="BrowseScriptsOutputDirectoryButton_Click" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,5,10,5" VerticalAlignment="Center" Text="Type d’export" />
                        <ComboBox x:Name="Ora2PgExportTypeComboBox" Grid.Row="3" Grid.Column="1" Margin="0,3" SelectedValuePath="Content" SelectedValue="TABLE">
                            <ComboBoxItem Content="TABLE" />
                            <ComboBoxItem Content="VIEW" />
                            <ComboBoxItem Content="SEQUENCE" />
                            <ComboBoxItem Content="FUNCTION" />
                            <ComboBoxItem Content="PROCEDURE" />
                            <ComboBoxItem Content="PACKAGE" />
                            <ComboBoxItem Content="TRIGGER" />
                            <ComboBoxItem Content="TYPE" />
                            <ComboBoxItem Content="GRANT" />
                            <ComboBoxItem Content="SYNONYM" />
                            <ComboBoxItem Content="DATA" />
                            <ComboBoxItem Content="INSERT" />
                            <ComboBoxItem Content="COPY" />
                        </ComboBox>
                        <Button x:Name="RefreshScriptsButton" Grid.Row="3" Grid.Column="2" Margin="8,3,0,3" Padding="10,4" Content="Actualiser la liste" Click="RefreshScriptsButton_Click" />
                        <Button x:Name="CreateScriptsButton" Grid.Row="3" Grid.Column="3" Margin="8,3,0,3" Padding="14,4" Background="#0078D4" Foreground="White" Content="Create Scripts" Click="CreateScriptsButton_Click" />
                    </Grid>

                    <DataGrid x:Name="ScriptsDataGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="1.2*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
                            <DataGridTextColumn Header="Emplacement" Binding="{Binding Location}" Width="2*" />
                            <DataGridTextColumn Header="Taille" Binding="{Binding Size}" Width="Auto" />
                            <DataGridTextColumn Header="Modifié le" Binding="{Binding Modified, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Log">
                <ListBox x:Name="LogListBox"
                         Margin="14"
                         ItemsSource="{Binding LogEntries}"
                         FontFamily="Consolas"
                         FontSize="12"
                         SelectionMode="Single"
                         PreviewKeyDown="LogListBox_PreviewKeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copier la ligne"
                                      InputGestureText="Ctrl+C"
                                      Click="CopyLogLineMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
